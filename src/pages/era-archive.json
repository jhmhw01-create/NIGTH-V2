  "headHtml": "\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width,initial-scale=1\" name=\"viewport\"/>\n<title>Era Archive — NIGHT</title>\n<meta content=\"데뷔부터 REST까지, 음악과 멤버 구성, 콘셉트의 변화로 이어지는 NIGHT의 시대별 아카이브.\" name=\"description\"/>\n<link href=\"assets/css/style.css\" rel=\"stylesheet\"/>\n<link href=\"assets/css/era-archive.css\" rel=\"stylesheet\"/>\n",
