tter-spacing:.08em}body.jiwoo-acting-page .acting-work{padding:82px 0;border-top:1px solid var(--line);scroll-margin-top:84px}body.jiwoo-acting-page .acting-back{display:inline-block;margin-bottom:32px;color:var(--muted);font-size:9px;letter-spacing:.14em}body.jiwoo-acting-page .acting-work-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.45fr);gap:40px;align-items:end;margin-bottom:34px}body.jiwoo-acting-page .acting-work-head span{color:var(--muted);font-size:9px;letter-spacing:.14em}body.jiwoo-acting-page .acting-work-head h2{margin:8px 0 0;font:400 clamp(36px,5vw,68px)/1.05 Georgia,Pretendard,serif}body.jiwoo-acting-page .acting-work-head strong{display:block;font-size:13px;font-weight:500}body.jiwoo-acting-page .acting-work-head p{margin:8px 0 0;color:var(--muted);font-size:10px;letter-spacing:.08em}body.jiwoo-acting-page .acting-gallery{columns:3 260px;column-gap:16px}body.jiwoo-acting-page .acting-gallery img{display:block;width:100%;height:auto;margin:0 0 16px;break-inside:avoid}@media(max-width:720px){body.jiwoo-acting-page .acting-hero{padding:54px 0 46px}body.jiwoo-acting-page .acting-filmography{padding:52px 0 72px}body.jiwoo-acting-page .acting-grid{grid-template-columns:1fr;gap:38px}body.jiwoo-acting-page .acting-work{padding:58px 0}body.jiwoo-acting-page .acting-work-head{grid-template-columns:1fr;gap:18px}body.jiwoo-acting-page .acting-gallery{columns:2 140px;column-gap:10px}body.jiwoo-acting-page .acting-gallery img{margin-bottom:10px}}</style>",
