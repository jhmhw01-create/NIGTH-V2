  "headHtml": "\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>NIGHT 1ST FAN-CON 〈MOONLIGHT CLUB〉</title>\n<meta name=\"description\" content=\"2029년 10월 13일부터 14일까지 열린 NIGHT의 첫 번째 팬콘 MOONLIGHT CLUB 공식 포토 아카이브.\">\n<link rel=\"stylesheet\" href=\"assets/css/style.css\">\n<style>\n.moonlight-club-page .page-hero{padding:46px 0 20px;}\n.moonlight-club-page .section{padding:30px 0;}\n.moonlight-club-page .section-title{margin-top:3px;margin-bottom:3px;}\n.moonlight-club-page .section-desc{margin-bottom:0;}\n.moonlight-club-page .gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;margin-top:10px;align-items:start;}\n.moonlight-club-page .gallery-item{min-width:0;min-height:0;height:auto!important;aspect-ratio:auto!important;margin:0;overflow:visible;align-self:start;display:block;}\n.moonlight-club-page .gallery-item img{position:static!important;inset:auto!important;display:block;width:100%;height:auto!important;min-height:0;aspect-ratio:auto!important;object-fit:contain;object-position:center;background:#090812;}\n.moonlight-club-page .gallery-item figcaption{position:static!important;padding:3px 0 0!important;margin:0!important;line-height:1.35;}\n.moonlight-club-page #visuals{padding-top:28px;padding-bottom:24px;}\n.moonlight-club-page #visuals .gallery-grid{grid-template-columns:repeat(2,minmax(0,420px));justify-content:center;align-items:start;gap:10px 16px;margin-top:10px;}\n.moonlight-club-page #visuals .gallery-item{width:100%;max-width:420px;justify-self:center;}\n.moonlight-club-page #visuals .gallery-item:last-child{grid-column:1/-1;max-width:760px;}\n.moonlight-club-page #visuals .gallery-item:last-child img{width:100%;height:auto;}\n.moonlight-club-page #day1{padding-top:30px;padding-bottom:18px;}\n.moonlight-club-page #day2{padding-top:22px;padding-bottom:24px;}\n.moonlight-club-page #day1>.container>.reveal,.moonlight-club-page #day2>.container>.reveal{margin-bottom:0;}\n@media(max-width:900px){.moonlight-club-page #visuals .gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr));}.moonlight-club-page #visuals .gallery-item:last-child{max-width:680px;}}\n@media(max-width:720px){.moonlight-club-page .page-hero{padding:36px 0 18px;}.moonlight-club-page .section,.moonlight-club-page #visuals{padding:24px 0;}.moonlight-club-page #day1{padding:24px 0 14px;}.moonlight-club-page #day2{padding:18px 0 22px;}.moonlight-club-page .gallery-grid,.moonlight-club-page #visuals .gallery-grid{grid-template-columns:1fr;gap:8px;margin-top:9px;}.moonlight-club-page #visuals .gallery-item{max-width:520px;}.moonlight-club-page #visuals .gallery-item:last-child{grid-column:auto;max-width:520px;}.moonlight-club-page .gallery-item figcaption{padding-top:2px!important;}}\n</style>\n",
