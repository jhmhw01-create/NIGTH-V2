  "headHtml": "\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>NIGHT — Notice</title>\n  <meta name=\"description\" content=\"NIGHT official notices and updates.\">\n  <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n\n\n<link rel=\"stylesheet\" href=\"assets/css/notice-archive.css\">\n",
  "beforeHeaderHtml": "\n  ",
  "contentHtml": "\n\n  <main>\n    <section class=\"page-hero notice-hero\">\n      <div class=\"container reveal\">\n        <span class=\"section-kicker\">Official Updates</span>\n        <h1 class=\"section-title\">Notice</h1>\n        <p class=\"section-desc\">NIGHT의 컴백, 콘텐츠 공개, 팬클럽 및 공식 사이트 업데이트 소식을 안내합니다.</p>\n      </div>\n    </section>\n\n    <section class=\"section notice-section\">\n      <div class=\"container\">\n        <div class=\"notice-tools\"><div class=\"notice-filter-buttons\" role=\"group\" aria-label=\"공지 분류\"><button type=\"button\" data-notice-filter=\"all\" aria-pressed=\"true\">전체</button><button type=\"button\" data-notice-filter=\"music\" aria-pressed=\"false\">앨범 · 컴백</button><button type=\"button\" data-notice-filter=\"stage\" aria-pressed=\"false\">무대</button><button type=\"button\" data-notice-filter=\"event\" aria-pressed=\"false\">공연 · 이벤트</button><button type=\"button\" data-notice-filter=\"fanclub\" aria-pressed=\"false\">팬클럽</button><button type=\"button\" data-notice-filter=\"contents\" aria-pressed=\"false\">콘텐츠</button><button type=\"button\" data-notice-filter=\"site\" aria-pressed=\"false\">사이트</button></div><label class=\"notice-year-label\">연도 <select id=\"notice-year-filter\"><option value=\"all\">전체 연도</option><option value=\"2029\">2029</option><option value=\"2028\">2028</option><option value=\"2027\">2027</option><option value=\"2026\">2026</option></select></label></div><p class=\"notice-results\" role=\"status\" aria-live=\"polite\">전체 공지 25건</p><div class=\"notice-head\"><span>DATE</span><span>CATEGORY</span><span>TITLE</span></div>\n<section class=\"notice-year-group\" aria-labelledby=\"notice-year-2029\"><h2 class=\"notice-year-title\" id=\"notice-year-2029\">2029</h2><div class=\"notice-list\">\n{{notices:23}}\n{{notices:24}}\n</div></section>\n<section class=\"notice-year-group\" aria-labelledby=\"notice-year-2028\"><h2 class=\"notice-year-title\" id=\"notice-year-2028\">2028</h2><div class=\"notice-list\">\n{{notices:0}}\n{{notices:1}}\n{{notices:2}}\n</div></section>\n<section class=\"notice-year-group\" aria-labelledby=\"notice-year-2027\"><h2 class=\"notice-year-title\" id=\"notice-year-2027\">2027</h2><div class=\"notice-list\">\n{{notices:3}}\n{{notices:4}}\n{{notices:5}}\n{{notices:6}}\n{{notices:7}}\n{{notices:8}}\n{{notices:9}}\n</div></section>\n<section class=\"notice-year-group\" aria-labelledby=\"notice-year-2026\"><h2 class=\"notice-year-title\" id=\"notice-year-2026\">2026</h2><div class=\"notice-list\">\n{{notices:10}}\n{{notices:11}}\n{{notices:12}}\n{{notices:13}}\n{{notices:14}}\n{{notices:15}}\n{{notices:16}}\n{{notices:17}}\n{{notices:18}}\n{{notices:19}}\n{{notices:20}}\n{{notices:21}}\n{{notices:22}}\n</div></section>\n<p class=\"notice-empty\" hidden>해당 분류와 연도에 공지가 없습니다.</p>\n      </div>\n    </section>\n  </main>\n\n  ",
  "afterFooterHtml": "\n  <script src=\"assets/js/main.js\"></script>\n<script src=\"assets/js/notice-archive.js\"></script>\n"
