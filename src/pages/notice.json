  "bodyAttributes": "",
  "headHtml": "\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>NIGHT — Notice</title>\n  <meta name=\"description\" content=\"NIGHT official notices and updates.\">\n  <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n\n\n<link rel=\"stylesheet\" href=\"assets/css/notice-archive.css\">\n",
  "beforeHeaderHtml": "\n  ",
  "contentHtml": "\n\n  <main>\n    <section class=\"page-hero notice-hero\">\n      <div class=\"container reveal\">\n        <span class=\"section-kicker\">Official Updates</span>\n        <h1 class=\"section-title\">Notice</h1>\n        <p class=\"section-desc\">NIGHT의 컴백, 콘텐츠 공개, 팬클럽 및 공식 사이트 업데이트 소식을 안내합니다.</p>\n      </div>\n    </section>\n\n    <section class=\"section notice-section\">\n      <div class=\"container\">\n        <div class=\"notice-tools\"><div class=\"notice-filter-buttons\" role=\"group\" aria-label=\"공지 분류\"><button type=\"button\" data-notice-filter=\"all\" aria-pressed=\"true\">전체</button><button type=\"button\" data-notice-filter=\"music\" aria-pressed=\"false\">앨범 · 컴백</button><button type=\"button\" data-notice-filter=\"stage\" aria-pressed=\"false\">무대</button><button type=\"button\" data-notice-filter=\"event\" aria-pressed=\"false\">공연 · 이벤트</button><button type=\"button\" data-notice-filter=\"fanclub\" aria-pressed=\"false\">팬클럽</button><button type=\"button\" data-notice-filter=\"contents\" aria-pressed=\"false\">콘텐츠</button><button type=\"button\" data-notice-filter=\"site\" aria-pressed=\"false\">사이트</button></div><label class=\"notice-year-label\">연도 <select id=\"notice-year-filter\"><option value=\"all\">전체 연도</option><option value=\"2030\">2030</option><option value=\"2029\">2029</option><option value=\"2028\">2028</option><option value=\"2027\">2027</option><option value=\"2026\">2026</option></select></label></div><p class=\"notice-results\" role=\"status\" aria-live=\"polite\">전체 공지 {{noticeCount}}건</p><div class=\"notice-head\"><span>DATE</span><span>CATEGORY</span><span>TITLE</span></div>\n{{noticesByDate}}\n<p class=\"notice-empty\" hidden>해당 분류와 연도에 공지가 없습니다.</p>\n      </div>\n    </section>\n  </main>\n\n  ",
  "afterFooterHtml": ""
}
