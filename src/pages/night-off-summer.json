  "headHtml": "<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>NIGHT OFF SUMMER — NIGHT</title><meta name=\"description\" content=\"DAY 1–4의 여름 휴가 사진 21장과 휴가 후 첫 라이브 10장 및 전체 대화.\"><link rel=\"stylesheet\" href=\"assets/css/style.css\"><link rel=\"stylesheet\" href=\"assets/css/archive-2026.css\"><link rel=\"stylesheet\" href=\"assets/css/archive-2027.css\"><link rel=\"stylesheet\" href=\"assets/css/night-off-summer.css\">",
