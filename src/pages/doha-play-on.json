template-columns:1fr;gap:16px}body.play-on-page[data-night-stage-detail] .play-on-grid.fansign-grid{grid-template-columns:1fr;gap:28px}body.play-on-page[data-night-stage-detail] .play-on-chapter{padding:48px 0}body.play-on-page[data-night-stage-detail] .play-on-official-era{padding-top:82px}body.play-on-page[data-night-stage-detail] .play-on-photo b{max-width:none}}</style>",
