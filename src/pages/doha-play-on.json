  "headHtml": "<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>DOHA — PLAY ON</title><meta name=\"description\" content=\"DOHA 개인 스케줄 예능 PLAY ON 공식 아카이브. 임시 멤버 첫 합류부터 고정 멤버 전환과 마지막 승리까지 27개의 기록.\"><link rel=\"stylesheet\" href=\"assets/css/style.css\"><link rel=\"stylesheet\" href=\"assets/css/fansign.css\"><style>body.play-on-page[data-night-stage-detail] .play-on-hero{padding:72px 0 58px;border-bottom:1px solid var(--line)}body.play-on-page[data-night-stage-detail] .play-on-hero .section-kicker{display:block;margin-bottom:12px}body.play-on-page[data-night-stage-detail] .play-on-hero h1{margin:0;font:400 clamp(58px,10vw,132px)/.9 Georgia,serif;letter-spacing:-.035em}body.play-on-page[data-night-stage-detail] .play-on-hero h1 span{display:block;margin-top:18px;font:400 clamp(15px,2.2vw,26px)/1.3 Inter,Pretendard,sans-serif;letter-spacing:.16em;color:var(--muted)}body.play-on-page[data-night-stage-detail] .play-on-hero p{max-width:680px;margin:28px 0 0;color:var(--muted);font-size:13px;line-height:1.9}body.play-on-page[data-night-stage-detail] .play-on-nav{position:sticky;top:72px;z-index:20;border-bottom:1px solid var(--line);background:rgba(21,20,18,.96);backdrop-filter:blur(12px)}body.play-on-page[data-night-stage-detail] .play-on-nav .container{display:flex;gap:26px;overflow-x:auto;padding-top:12px;padding-bottom:12px;scrollbar-width:none}body.play-on-page[data-night-stage-detail] .play-on-nav a{flex:none;min-height:44px;padding:14px 0;color:var(--muted);font-size:9px;letter-spacing:.12em;white-space:nowrap}body.play-on-page[data-night-stage-detail] .play-on-nav a:hover{color:var(--text)}body.play-on-page[data-night-stage-detail] .play-on-chapter{padding:68px 0;border-bottom:1px solid var(--line)}body.play-on-page[data-night-stage-detail] .play-on-head{display:grid;grid-template-columns:minmax(180px,.42fr) minmax(0,1fr);gap:42px;align-items:end;margin-bottom:30px}body.play-on-page[data-night-stage-detail] .pla